# FALLBACK build of the NGS-DOSE image for forks, offline sites, or before a release has been
# published: provisioning normally pulls the CI-published image, which needs no privileges,
#     apptainer pull ngs-dose.sif docker://ghcr.io/jlanej/ngs-dose:sha-<commit>
# This definition mirrors NGS-DOSE's Dockerfile (which NGS-DOSE's CI builds and smoke-tests; this file
# itself has not been built by CI). Run it from the root of a checkout of NGS-DOSE (the method), where
# `--fakeroot` is allowed (Apptainer 1.2 or later, for --build-arg):
#     apptainer build --fakeroot --build-arg NGSDOSE_BUILD=$(git rev-parse HEAD) ngs-dose.sif /path/to/NGS-DOSE-1000G/pipeline/ngs-dose.def
# Counts written by this image record that commit as engine_build. Without --build-arg they record
# 'dev', as a local cargo build does.

Bootstrap: docker
From: rust:1-bookworm
Stage: build

%arguments
    NGSDOSE_BUILD=dev

%files
    Cargo.toml /src/Cargo.toml
    Cargo.lock /src/Cargo.lock
    src /src/src

%post
    # clang/libclang: rust-htslib generates its htslib bindings with bindgen at build time
    apt-get update && apt-get install -y --no-install-recommends \
        clang libclang-dev pkg-config cmake zlib1g-dev libbz2-dev liblzma-dev libcurl4-openssl-dev libssl-dev
    cd /src && NGSDOSE_BUILD="{{ NGSDOSE_BUILD }}" cargo build --release --locked


Bootstrap: docker
From: python:3.12-slim-bookworm
Stage: final

%files from build
    /src/target/release/ngs-dose /usr/local/bin/ngs-dose

%files
    pyproject.toml /opt/ngs-dose/pyproject.toml
    README.md /opt/ngs-dose/README.md
    ngsdose /opt/ngs-dose/ngsdose
    resources /opt/ngs-dose/resources
    docs /opt/ngs-dose/docs

%post
    apt-get update && apt-get install -y --no-install-recommends ca-certificates libcurl4 libbz2-1.0 liblzma5 zlib1g aria2 curl
    rm -rf /var/lib/apt/lists/*
    pip install --no-cache-dir /opt/ngs-dose

%environment
    export NGSDOSE_RESOURCES=/opt/ngs-dose/resources/GRCh38
    export NGSDOSE_SATELLITES=/opt/ngs-dose/resources/experimental/satellites.CHM13v2.k31.panel.tsv.gz
    export NGSDOSE_TELOMERE=/opt/ngs-dose/resources/experimental/telomere.k31.panel.tsv.gz

%test
    ngs-dose --version
    ngsdose selftest
